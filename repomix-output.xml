                        keyboardType: TextInputType.emailAddress,
                      ),
                      const SizedBox(height: 18),

                      Leertexto(
                        label: 'Contraseña',
                        controller: contrasenaController,
                        obscureText: ocultarContrasena,
                        suffixIcon: IconButton(
                          onPressed: _alternarVisibilidadContrasena,
                          icon: Icon(
