import 'dart:typed_data';

import 'package:flutter/material.dart';
import 'package:fronted/colores/stilocolores.dart';
import 'package:fronted/components/login/fondo.dart';
import 'package:fronted/model/productos.dart';
import 'package:fronted/model/subcategoria.dart';
import 'package:fronted/paginas/admin/widets.dart/barranavega.dart';
import 'package:fronted/paginas/admin/widets.dart/targetaproducto.dart';
import 'package:fronted/paginas/admin/widets.dart/targetapedido.dart'
    show FotoCuadrada;
import 'package:fronted/service/productoservice.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:image_picker/image_picker.dart';

/// Pantalla del admin para modificar el inventario: lista todos los productos,
/// permite buscar, añadir uno nuevo, editar (tocando la tarjeta) y eliminar.
class Actualizarinventario extends StatefulWidget {
  const Actualizarinventario({super.key});

  @override
  State<Actualizarinventario> createState() => _ActualizarinventarioState();
}

class _ActualizarinventarioState extends State<Actualizarinventario> {
  final ProductosService _service = ProductosService();
  final TextEditingController _buscador = TextEditingController();
  late Future<List<Producto>> _futuroProductos;
  String _busqueda = '';

  @override
  void initState() {
    super.initState();
    _futuroProductos = _service.obtenerTodos();
  }

  @override
  void dispose() {
    _buscador.dispose();
    super.dispose();
  }

  Future<void> _recargar() async {
    setState(() {
      _futuroProductos = _service.obtenerTodos();
    });
    await _futuroProductos.catchError((_) => <Producto>[]);
  }

  /// Filtra por nombre, ID o subcategoría.
  List<Producto> _filtrar(List<Producto> productos) {
    final q = _busqueda.trim().toLowerCase();
    if (q.isEmpty) return productos;
    return productos.where((p) {
      return p.nombre.toLowerCase().contains(q) ||
          p.id.toString() == q ||
          (p.subcategoria ?? '').toLowerCase().contains(q);
    }).toList();
  }

  void _avisar(String texto, {bool error = false}) {
    if (!mounted) return;
    ScaffoldMessenger.of(context).showSnackBar(
      SnackBar(
        backgroundColor: error ? const Color(0xFFB71C1C) : AppColors.azulOscuro,
        content: Text(texto, style: GoogleFonts.poppins(color: Colors.white)),
      ),
    );
  }

  /// Abre el formulario: con [producto] edita, sin producto crea uno nuevo.
  Future<void> _abrirFormulario({Producto? producto}) async {
    final guardado = await showModalBottomSheet<bool>(
      context: context,
      isScrollControlled: true,
      backgroundColor: AppColors.fondoTarjeta,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(28)),
      ),
      builder: (_) => _HojaProducto(producto: producto, service: _service),
    );

    if (guardado == true && mounted) {
      _avisar(
        producto == null
            ? 'Producto añadido correctamente'
            : 'Producto actualizado correctamente',
      );
      _recargar();
    }
  }

  Future<void> _editar(Producto producto) =>
      _abrirFormulario(producto: producto);

  Future<void> _anadir() => _abrirFormulario();

  Future<void> _eliminar(Producto producto) async {
    final confirmar = await showDialog<bool>(
      context: context,
      builder: (ctx) => AlertDialog(
        backgroundColor: AppColors.fondoTarjeta,
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(22)),
        title: Text(
          'Eliminar producto',
          style: GoogleFonts.poppins(
            color: Colors.white,
            fontWeight: FontWeight.bold,
          ),
        ),
        content: Text(
          '¿Seguro que desea eliminar "${producto.nombre}" (ID ${producto.id})? '
          'Esta acción no se puede deshacer.',
          style: GoogleFonts.poppins(color: Colors.white70, fontSize: 14),
        ),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(ctx, false),
            child: Text(
              'Cancelar',
              style: GoogleFonts.poppins(color: Colors.white70),
            ),
          ),
          ElevatedButton(
            onPressed: () => Navigator.pop(ctx, true),
            style: ElevatedButton.styleFrom(
              backgroundColor: const Color(0xFFFF5252),
              foregroundColor: Colors.white,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(20),
              ),
            ),
            child: Text(
              'Eliminar',
              style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
            ),
          ),
        ],
      ),
    );
    if (confirmar != true) return;

    try {
      await _service.eliminarProducto(producto.id);
      _avisar('Producto eliminado correctamente');
      _recargar();
    } catch (e) {
      _avisar(e.toString().replaceFirst('Exception: ', ''), error: true);
    }
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      bottomNavigationBar: Barranavegacioninferior(
        botones: [
          BotonNav(
            icon: Icons.arrow_back,
            size: 26,
            onTap: () => Navigator.pop(context),
          ),
        ],
      ),
      body: Fondo(
        child: SafeArea(
          child: Column(
            children: [
              Padding(
                padding: const EdgeInsets.symmetric(
                  horizontal: 36,
                  vertical: 20,
                ),
                child: Center(
                  child: Text(
                    'Megatech 2',
                    style: GoogleFonts.poppins(
                      color: Colors.white,
                      fontSize: 24,
                      fontWeight: FontWeight.bold,
                    ),
                  ),
                ),
              ),
              Text(
                'Actualizar inventario',
                style: GoogleFonts.poppins(
                  color: const Color(0xFF1BC2F0),
                  fontSize: 24,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 12),
              _campoBusqueda(),
              const SizedBox(height: 10),
              _botonAnadir(),
              const SizedBox(height: 12),
              Expanded(
                child: FutureBuilder<List<Producto>>(
                  future: _futuroProductos,
                  builder: (context, snapshot) {
                    if (snapshot.connectionState == ConnectionState.waiting) {
                      return const Center(
                        child: CircularProgressIndicator(
                          color: AppColors.azulClaro,
                        ),
                      );
                    }

                    if (snapshot.hasError) {
                      return _mensaje(
                        icono: Icons.wifi_off_rounded,
                        texto: 'No se pudieron cargar los productos',
                        conBoton: true,
                      );
                    }

                    final productos = _filtrar(snapshot.data ?? []);
                    if (productos.isEmpty) {
                      return _mensaje(
                        icono: Icons.search_off_rounded,
                        texto: _busqueda.isEmpty
                            ? 'Todavía no hay productos registrados'
                            : 'No se encontraron productos',
                      );
                    }

                    return RefreshIndicator(
                      color: AppColors.azulClaro,
                      onRefresh: _recargar,
                      child: ListView.separated(
                        physics: const AlwaysScrollableScrollPhysics(),
                        padding: const EdgeInsets.fromLTRB(20, 4, 20, 20),
                        itemCount: productos.length,
                        separatorBuilder: (_, __) => const SizedBox(height: 14),
                        itemBuilder: (context, i) => GestureDetector(
                          onTap: () => _editar(productos[i]),
                          child: Stack(
                            children: [
                              TarjetaProductoAdmin(producto: productos[i]),
                              const Positioned(
                                top: 10,
                                right: 14,
                                child: Icon(
                                  Icons.edit_rounded,
                                  color: AppColors.azulClaro,
                                  size: 20,
                                ),
                              ),
                              Positioned(
                                bottom: 6,
                                right: 8,
                                child: IconButton(
                                  tooltip: 'Eliminar producto',
                                  onPressed: () => _eliminar(productos[i]),
                                  icon: const Icon(
                                    Icons.delete_rounded,
                                    color: Color(0xFFFF5252),
                                    size: 24,
                                  ),
                                ),
                              ),
                            ],
                          ),
                        ),
                      ),
                    );
                  },
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _campoBusqueda() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 20),
      child: TextField(
        controller: _buscador,
        onChanged: (v) => setState(() => _busqueda = v),
        style: GoogleFonts.poppins(color: Colors.black, fontSize: 14),
        decoration: InputDecoration(
          hintText: 'Buscar por nombre, ID o categoría',
          hintStyle: GoogleFonts.poppins(color: Colors.black45, fontSize: 13),
          prefixIcon: const Icon(Icons.search, color: AppColors.iconoCampo),
          suffixIcon: _busqueda.isEmpty
              ? null
              : IconButton(
                  icon: const Icon(Icons.close, color: AppColors.iconoCampo),
                  onPressed: () {
                    _buscador.clear();
                    setState(() => _busqueda = '');
                  },
                ),
          filled: true,
          fillColor: AppColors.fondoCampo,
          contentPadding: const EdgeInsets.symmetric(vertical: 12),
          border: OutlineInputBorder(
            borderRadius: BorderRadius.circular(25),
            borderSide: BorderSide.none,
          ),
        ),
      ),
    );
  }

  Widget _botonAnadir() {
    return Padding(
      padding: const EdgeInsets.symmetric(horizontal: 20),
      child: GestureDetector(
        onTap: _anadir,
        child: Container(
          width: double.infinity,
          padding: const EdgeInsets.symmetric(vertical: 12),
          decoration: BoxDecoration(
            gradient: AppColors.gradienteBoton,
            borderRadius: BorderRadius.circular(25),
          ),
          child: Row(
            mainAxisAlignment: MainAxisAlignment.center,
            children: [
              const Icon(Icons.add_circle_outline, color: Colors.white),
              const SizedBox(width: 8),
              Text(
                'Añadir producto',
                style: GoogleFonts.poppins(
                  color: Colors.white,
                  fontWeight: FontWeight.bold,
                  fontSize: 15,
                ),
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _mensaje({
    required IconData icono,
    required String texto,
    bool conBoton = false,
  }) {
    return Center(
      child: Padding(
        padding: const EdgeInsets.symmetric(horizontal: 36),
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            Icon(icono, color: Colors.white54, size: 56),
            const SizedBox(height: 12),
            Text(
              texto,
              textAlign: TextAlign.center,
              style: GoogleFonts.poppins(color: Colors.white70, fontSize: 15),
            ),
            if (conBoton) ...[
              const SizedBox(height: 16),
              ElevatedButton(
                onPressed: _recargar,
                style: ElevatedButton.styleFrom(
                  backgroundColor: const Color(0xFF3FA9F5),
                  foregroundColor: Colors.white,
                  shape: RoundedRectangleBorder(
                    borderRadius: BorderRadius.circular(20),
                  ),
                ),
                child: Text(
                  'Reintentar',
                  style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
                ),
              ),
            ],
          ],
        ),
      ),
    );
  }
}

/// Formulario que se abre desde abajo para crear (producto == null) o editar
/// un producto.
class _HojaProducto extends StatefulWidget {
  final Producto? producto;
  final ProductosService service;

  const _HojaProducto({required this.producto, required this.service});

  @override
  State<_HojaProducto> createState() => _HojaProductoState();
}

class _HojaProductoState extends State<_HojaProducto> {
  final _formKey = GlobalKey<FormState>();
  late final TextEditingController _nombre;
  late final TextEditingController _descripcion;
  late final TextEditingController _precio;
  late final TextEditingController _stock;

  final ImagePicker _picker = ImagePicker();
  XFile? _fotoNueva; // foto elegida (null = se conserva la actual)
  Uint8List? _bytesFotoNueva; // para mostrar la vista previa

  bool _guardando = false;
  String? _error;

  bool get _esNuevo => widget.producto == null;

  // Solo se usan al crear: la subcategoría se elige de la lista del backend.
  late Future<List<Subcategoria>> _futuroSubcategorias;
  int? _idSubcategoria;

  @override
  void initState() {
    super.initState();
    final p = widget.producto;
    _nombre = TextEditingController(text: p?.nombre ?? '');
    _descripcion = TextEditingController(text: p?.descripcion ?? '');
    _precio = TextEditingController(
      text: p == null
          ? ''
          : p.precio % 1 == 0
          ? p.precio.toInt().toString()
          : p.precio.toString(),
    );
    _stock = TextEditingController(text: (p?.stock ?? 0).toString());
    if (_esNuevo) {
      _futuroSubcategorias = widget.service.obtenerSubcategorias();
    }
  }

  @override
  void dispose() {
    _nombre.dispose();
    _descripcion.dispose();
    _precio.dispose();
    _stock.dispose();
    super.dispose();
  }

  /// Pregunta si la foto viene de la galería o de la cámara.
  Future<void> _elegirFoto() async {
    final origen = await showModalBottomSheet<ImageSource>(
      context: context,
      backgroundColor: AppColors.fondoOscuro2,
      shape: const RoundedRectangleBorder(
        borderRadius: BorderRadius.vertical(top: Radius.circular(24)),
      ),
      builder: (_) => SafeArea(
        child: Column(
          mainAxisSize: MainAxisSize.min,
          children: [
            ListTile(
              leading: const Icon(
                Icons.photo_library_rounded,
                color: Colors.white,
              ),
              title: Text(
                'Elegir de la galería',
                style: GoogleFonts.poppins(color: Colors.white),
              ),
              onTap: () => Navigator.pop(context, ImageSource.gallery),
            ),
            ListTile(
              leading: const Icon(
                Icons.photo_camera_rounded,
                color: Colors.white,
              ),
              title: Text(
                'Tomar una foto',
                style: GoogleFonts.poppins(color: Colors.white),
              ),
              onTap: () => Navigator.pop(context, ImageSource.camera),
            ),
          ],
        ),
      ),
    );
    if (origen == null) return;

    try {
      final foto = await _picker.pickImage(
        source: origen,
        maxWidth: 1200, // reduce el peso antes de subirla
        imageQuality: 85,
      );
      if (foto == null) return;
      final bytes = await foto.readAsBytes();
      if (!mounted) return;
      setState(() {
        _fotoNueva = foto;
        _bytesFotoNueva = bytes;
        _error = null;
      });
    } catch (_) {
      if (!mounted) return;
      setState(() => _error = 'No se pudo abrir la cámara o la galería');
    }
  }

  void _quitarFotoNueva() => setState(() {
    _fotoNueva = null;
    _bytesFotoNueva = null;
  });

  Widget _selectorFoto() {
    const tam = 130.0;
    final vista = _bytesFotoNueva != null
        ? ClipRRect(
            borderRadius: BorderRadius.circular(18),
            child: Image.memory(
              _bytesFotoNueva!,
              width: tam,
              height: tam,
              fit: BoxFit.cover,
            ),
          )
        : FotoCuadrada(url: widget.producto?.foto, tam: tam);

    return Column(
      children: [
        GestureDetector(
          onTap: _guardando ? null : _elegirFoto,
          child: Stack(
            children: [
              Container(
                decoration: BoxDecoration(
                  borderRadius: BorderRadius.circular(20),
                  border: Border.all(
                    color: _fotoNueva != null
                        ? AppColors.azulClaro
                        : AppColors.bordeTarjeta,
                    width: 1.5,
                  ),
                ),
                child: vista,
              ),
              Positioned(
                right: 6,
                bottom: 6,
                child: Container(
                  padding: const EdgeInsets.all(6),
                  decoration: const BoxDecoration(
                    shape: BoxShape.circle,
                    gradient: AppColors.gradienteBoton,
                  ),
                  child: const Icon(Icons.edit, color: Colors.white, size: 16),
                ),
              ),
            ],
          ),
        ),
        const SizedBox(height: 6),
        if (_fotoNueva == null)
          TextButton(
            onPressed: _guardando ? null : _elegirFoto,
            child: Text(
              _esNuevo ? 'Elegir foto' : 'Cambiar foto',
              style: GoogleFonts.poppins(
                color: AppColors.azulClaro,
                fontWeight: FontWeight.bold,
              ),
            ),
          )
        else
          TextButton(
            onPressed: _guardando ? null : _quitarFotoNueva,
            child: Text(
              'Descartar foto nueva',
              style: GoogleFonts.poppins(color: Colors.white70),
            ),
          ),
      ],
    );
  }

  void _cambiarStock(int delta) {
    final actual = int.tryParse(_stock.text.trim()) ?? 0;
    final nuevo = (actual + delta).clamp(0, 999999);
    setState(() => _stock.text = nuevo.toString());
  }

  Future<void> _guardar() async {
    if (!_formKey.currentState!.validate()) return;

    setState(() {
      _guardando = true;
      _error = null;
    });

    try {
      final precio = double.parse(_precio.text.trim().replaceAll(',', '.'));
      final stock = int.parse(_stock.text.trim());

      if (_esNuevo) {
        await widget.service.crearProducto(
          nombre: _nombre.text.trim(),
          descripcion: _descripcion.text.trim(),
          precio: precio,
          stock: stock,
          idSubcategoria: _idSubcategoria!,
          foto: _fotoNueva,
        );
      } else {
        await widget.service.actualizarProducto(
          widget.producto!.id,
          nombre: _nombre.text.trim(),
          descripcion: _descripcion.text.trim(),
          precio: precio,
          stock: stock,
          foto: _fotoNueva,
        );
      }
      if (mounted) Navigator.pop(context, true);
    } catch (e) {
      if (!mounted) return;
      setState(() {
        _guardando = false;
        _error = e.toString().replaceFirst('Exception: ', '');
      });
    }
  }

  InputDecoration _decoracion(String etiqueta, {String? prefijo}) {
    final borde = OutlineInputBorder(
      borderRadius: BorderRadius.circular(18),
      borderSide: const BorderSide(color: AppColors.bordeTarjeta),
    );
    return InputDecoration(
      labelText: etiqueta,
      prefixText: prefijo,
      prefixStyle: GoogleFonts.poppins(color: Colors.white),
      labelStyle: GoogleFonts.poppins(color: Colors.white70, fontSize: 13),
      filled: true,
      fillColor: AppColors.fondoOscuro2,
      enabledBorder: borde,
      focusedBorder: borde.copyWith(
        borderSide: const BorderSide(color: AppColors.azulClaro, width: 2),
      ),
      errorBorder: borde.copyWith(
        borderSide: const BorderSide(color: Color(0xFFFF5252)),
      ),
      focusedErrorBorder: borde.copyWith(
        borderSide: const BorderSide(color: Color(0xFFFF5252), width: 2),
      ),
    );
  }

  @override
  Widget build(BuildContext context) {
    final estiloTexto = GoogleFonts.poppins(color: Colors.white, fontSize: 14);

    return Padding(
      // Sube el formulario cuando aparece el teclado
      padding: EdgeInsets.only(
        bottom: MediaQuery.of(context).viewInsets.bottom,
      ),
      child: SingleChildScrollView(
        padding: const EdgeInsets.fromLTRB(24, 16, 24, 24),
        child: Form(
          key: _formKey,
          child: Column(
            mainAxisSize: MainAxisSize.min,
            crossAxisAlignment: CrossAxisAlignment.stretch,
            children: [
              Center(
                child: Container(
                  width: 44,
                  height: 4,
                  decoration: BoxDecoration(
                    color: Colors.white24,
                    borderRadius: BorderRadius.circular(2),
                  ),
                ),
              ),
              const SizedBox(height: 16),
              Text(
                _esNuevo
                    ? 'Añadir producto'
                    : 'Editar producto #${widget.producto!.id}',
                textAlign: TextAlign.center,
                style: GoogleFonts.poppins(
                  color: AppColors.azulClaro,
                  fontSize: 20,
                  fontWeight: FontWeight.bold,
                ),
              ),
              const SizedBox(height: 14),
              Center(child: _selectorFoto()),
              const SizedBox(height: 10),
              TextFormField(
                controller: _nombre,
                style: estiloTexto,
                textCapitalization: TextCapitalization.sentences,
                decoration: _decoracion('Nombre'),
                validator: (v) => (v == null || v.trim().isEmpty)
                    ? 'Escriba el nombre'
                    : null,
              ),
              const SizedBox(height: 12),
              if (_esNuevo) ...[
                _selectorSubcategoria(),
                const SizedBox(height: 12),
              ],
              TextFormField(
                controller: _descripcion,
                style: estiloTexto,
                maxLines: 3,
                minLines: 2,
                textCapitalization: TextCapitalization.sentences,
                decoration: _decoracion('Descripción'),
              ),
              const SizedBox(height: 12),
              TextFormField(
                controller: _precio,
                style: estiloTexto,
                keyboardType: const TextInputType.numberWithOptions(
                  decimal: true,
                ),
                decoration: _decoracion('Precio', prefijo: '\$ '),
                validator: (v) {
                  final n = double.tryParse(
                    (v ?? '').trim().replaceAll(',', '.'),
                  );
                  if (n == null || n <= 0) return 'Precio inválido';
                  return null;
                },
              ),
              const SizedBox(height: 12),
              Row(
                children: [
                  _botonStock(Icons.remove, () => _cambiarStock(-1)),
                  const SizedBox(width: 10),
                  Expanded(
                    child: TextFormField(
                      controller: _stock,
                      style: estiloTexto,
                      textAlign: TextAlign.center,
                      keyboardType: TextInputType.number,
                      decoration: _decoracion('Stock (unidades)'),
                      validator: (v) {
                        final n = int.tryParse((v ?? '').trim());
                        if (n == null || n < 0) return 'Stock inválido';
                        return null;
                      },
                    ),
                  ),
                  const SizedBox(width: 10),
                  _botonStock(Icons.add, () => _cambiarStock(1)),
                ],
              ),
              if (_error != null) ...[
                const SizedBox(height: 12),
                Text(
                  _error!,
                  textAlign: TextAlign.center,
                  style: GoogleFonts.poppins(
                    color: const Color(0xFFFF5252),
                    fontSize: 13,
                  ),
                ),
              ],
              const SizedBox(height: 20),
              Row(
                children: [
                  Expanded(
                    child: OutlinedButton(
                      onPressed: _guardando
                          ? null
                          : () => Navigator.pop(context),
                      style: OutlinedButton.styleFrom(
                        foregroundColor: Colors.white,
                        side: const BorderSide(color: Colors.white38),
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(25),
                        ),
                      ),
                      child: Text(
                        'Cancelar',
                        style: GoogleFonts.poppins(fontWeight: FontWeight.bold),
                      ),
                    ),
                  ),
                  const SizedBox(width: 12),
                  Expanded(
                    child: ElevatedButton(
                      onPressed: _guardando ? null : _guardar,
                      style: ElevatedButton.styleFrom(
                        backgroundColor: AppColors.azulClaro,
                        foregroundColor: AppColors.textoBoton,
                        padding: const EdgeInsets.symmetric(vertical: 14),
                        shape: RoundedRectangleBorder(
                          borderRadius: BorderRadius.circular(25),
                        ),
                      ),
                      child: _guardando
                          ? const SizedBox(
                              width: 20,
                              height: 20,
                              child: CircularProgressIndicator(
                                strokeWidth: 2.5,
                                color: Colors.black,
                              ),
                            )
                          : Text(
                              _esNuevo ? 'Añadir' : 'Guardar',
                              style: GoogleFonts.poppins(
                                fontWeight: FontWeight.bold,
                              ),
                            ),
                    ),
                  ),
                ],
              ),
            ],
          ),
        ),
      ),
    );
  }

  Widget _selectorSubcategoria() {
    return FutureBuilder<List<Subcategoria>>(
      future: _futuroSubcategorias,
      builder: (context, snapshot) {
        if (snapshot.connectionState == ConnectionState.waiting) {
          return const Padding(
            padding: EdgeInsets.symmetric(vertical: 12),
            child: Center(
              child: SizedBox(
                width: 22,
                height: 22,
                child: CircularProgressIndicator(
                  strokeWidth: 2.5,
                  color: AppColors.azulClaro,
                ),
              ),
            ),
          );
        }

        if (snapshot.hasError) {
          return Row(
            children: [
              Expanded(
                child: Text(
                  'No se pudieron cargar las subcategorías',
                  style: GoogleFonts.poppins(
                    color: const Color(0xFFFF5252),
                    fontSize: 13,
                  ),
                ),
              ),
              TextButton(
                onPressed: () => setState(() {
                  _futuroSubcategorias = widget.service.obtenerSubcategorias();
                }),
                child: Text(
                  'Reintentar',
                  style: GoogleFonts.poppins(color: AppColors.azulClaro),
                ),
              ),
            ],
          );
        }

        final lista = snapshot.data ?? [];
        return DropdownButtonFormField<int>(
          value: _idSubcategoria,
          isExpanded: true,
          dropdownColor: AppColors.fondoOscuro2,
          iconEnabledColor: Colors.white70,
          style: GoogleFonts.poppins(color: Colors.white, fontSize: 14),
          decoration: _decoracion('Subcategoría'),
          items: lista
              .map(
                (s) => DropdownMenuItem<int>(
                  value: s.id,
                  child: Text(s.nombre, overflow: TextOverflow.ellipsis),
                ),
              )
              .toList(),
          onChanged: _guardando
              ? null
              : (v) => setState(() => _idSubcategoria = v),
          validator: (v) => v == null ? 'Elija una subcategoría' : null,
        );
      },
    );
  }

  Widget _botonStock(IconData icono, VoidCallback onTap) {
    return GestureDetector(
      onTap: onTap,
      child: Container(
        width: 46,
        height: 46,
        decoration: const BoxDecoration(
          shape: BoxShape.circle,
          gradient: AppColors.gradienteBoton,
        ),
        child: Icon(icono, color: Colors.white),
      ),
    );
  }
}
